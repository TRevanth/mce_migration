# Copy to server/.env and fill in.
SESSION_SECRET=change-me
WEB_URL=http://localhost:5173

# Salesforce Connected App / External Client App (OAuth, PKCE, callback below)
SF_CLIENT_ID=your_salesforce_client_id
SF_CLIENT_SECRET=your_salesforce_client_secret
SF_LOGIN_URL=https://login.salesforce.com
SF_REDIRECT_URI=http://localhost:3001/api/sf/callback

# Optional: default Marketing Cloud Engagement credentials (skips the Connect form)
MCE_SUBDOMAIN=
MCE_CLIENT_ID=
MCE_CLIENT_SECRET=
MCE_ACCOUNT_ID=

# AI agent (Claude API). AGENT_MODEL is optional, default claude-opus-5-5.
ANTHROPIC_API_KEY=
AGENT_MODEL=
